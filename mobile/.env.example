# Copiar este ficheiro para .env.local dentro da pasta mobile.
# Substituir IP-DO-COMPUTADOR pelo IPv4 do computador que executa a API.
# No telemóvel, localhost aponta para o próprio telemóvel.
# As variáveis EXPO_PUBLIC_* são públicas: não colocar passwords ou tokens.

# Endereço base dos futuros pedidos aos endpoints Laravel.
EXPO_PUBLIC_API_URL=http://IP-DO-COMPUTADOR:8000/api

# Rota de diagnóstico do servidor, fora do prefixo /api.
EXPO_PUBLIC_API_HEALTH_URL=http://IP-DO-COMPUTADOR:8000/up

# Estes endereços HTTP destinam-se ao desenvolvimento na rede local.
# Após alterações, reiniciar o Expo e recarregar a aplicação.
