{
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {},
    "preview-local": {
      "extends": "preview",
      "environment": "preview",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "http://10.0.2.2:8000/api",
        "EXPO_PUBLIC_API_HEALTH_URL": "http://10.0.2.2:8000/api/health"
      }
    }
  }
}
